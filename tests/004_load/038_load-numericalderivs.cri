point 0.1 0.2 0.3 field "abs(elf(2)-elf(1)) < 1e-5"

# promolecular
crystal library urea
load promolecular analytical
load promolecular numerical
point 0.1 0.2 0.3 field "abs($2:x-$1:x) < 1e-6"
point 0.1 0.2 0.3 field "abs($2:y-$1:y) < 1e-6"
point 0.1 0.2 0.3 field "abs($2:z-$1:z) < 1e-6"
point 0.1 0.2 0.3 field "abs($2:xx-$1:xx) < 1e-4"
point 0.1 0.2 0.3 field "abs($2:xy-$1:xy) < 1e-4"
