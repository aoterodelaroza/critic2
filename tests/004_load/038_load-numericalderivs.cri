point 0.1 0.2 0.3 field "abs($2:xy-$1:xy) < 1e-3"
point 0.1 0.2 0.3 field "abs($2:xz-$1:xz) < 1e-3"
point 0.1 0.2 0.3 field "abs($2:yy-$1:yy) < 1e-3"
point 0.1 0.2 0.3 field "abs($2:yz-$1:yz) < 1e-3"
point 0.1 0.2 0.3 field "abs($2:zz-$1:zz) < 1e-3"
