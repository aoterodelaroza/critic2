point 0.1 0.2 0.3 field "abs($2:yy-$1:yy) < 1e-4"
point 0.1 0.2 0.3 field "abs($2:yz-$1:yz) < 1e-4"
point 0.1 0.2 0.3 field "abs($2:zz-$1:zz) < 1e-4"

# promolecular (fragment)
crystal library urea
write 038_load-numericalderivs.xyz onemotif nmer 1
load promolecular fragment 038_load-numericalderivs_monomer_1.xyz analytical
load promolecular fragment 038_load-numericalderivs_monomer_1.xyz numerical
point 0.1 0.2 0.3 field "abs($2:x-$1:x) < 1e-6"
point 0.1 0.2 0.3 field "abs($2:y-$1:y) < 1e-6"
point 0.1 0.2 0.3 field "abs($2:z-$1:z) < 1e-6"
point 0.1 0.2 0.3 field "abs($2:xx-$1:xx) < 1e-4"
point 0.1 0.2 0.3 field "abs($2:xy-$1:xy) < 1e-4"
point 0.1 0.2 0.3 field "abs($2:xz-$1:xz) < 1e-4"
point 0.1 0.2 0.3 field "abs($2:yy-$1:yy) < 1e-4"
