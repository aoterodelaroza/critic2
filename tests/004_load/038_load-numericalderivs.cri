load ../zz_source/g16A.03/benzene/benzene.wfn analytical
load ../zz_source/g16A.03/benzene/benzene.wfn numerical
point 0.1 0.2 0.3 field "abs($2:x-$1:x) < 1e-10"
point 0.1 0.2 0.3 field "abs($2:y-$1:y) < 1e-10"
point 0.1 0.2 0.3 field "abs($2:z-$1:z) < 1e-10"
point 0.1 0.2 0.3 field "abs($2:xx-$1:xx) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:xy-$1:xy) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:xz-$1:xz) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:yy-$1:yy) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:yz-$1:yz) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:zz-$1:zz) < 1e-7"
point 0.1 0.2 0.3 field "abs(kkin(2)-kkin(1)) < 1e-10"
point 0.1 0.2 0.3 field "abs(elf(2)-elf(1)) < 1e-10"
point 0.1 0.2 0.3 field "abs(brhole_b(2)-brhole_b(1)) < 1e-10"

# dftb+
crystal ../zz_source/dftb+-18.1/graphite/graphite.gen
load ../zz_source/dftb+-18.1/graphite/detailed.xml \
     ../zz_source/dftb+-18.1/graphite/eigenvec.bin \
     ../zz_source/dftb+-18.1/wfc-3ob-3-1.hsd analytical
