## delete: 038_load-numericalderivs_monomer_1.xyz 038_load-numericalderivs_monomer_2.xyz
## check: 038_load-numericalderivs.cro -a1e-10
## labels: regression

# Numerical (field 2) against analytical (field 1) derivatives. Every
# point evaluates a comparison, which is 1 if the two agree to within the
# tolerance and 0 otherwise, so that the reference output does not
# contain values at the level of the numerical noise. The tolerances
# are 10 times the observed error or more.

# grid (the point is off the grid planes: the second derivatives of the
# tricubic interpolant are discontinuous there)
crystal ../zz_source/qe-6.1/graphite/rho.cube
load ../zz_source/qe-6.1/graphite/rho.cube analytical
load ../zz_source/qe-6.1/graphite/rho.cube numerical
point 0.13 0.27 0.31 field "abs($2:x-$1:x) < 1e-10"
point 0.13 0.27 0.31 field "abs($2:y-$1:y) < 1e-10"
point 0.13 0.27 0.31 field "abs($2:z-$1:z) < 1e-10"
point 0.13 0.27 0.31 field "abs($2:xx-$1:xx) < 1e-7"
point 0.13 0.27 0.31 field "abs($2:xy-$1:xy) < 1e-7"
point 0.13 0.27 0.31 field "abs($2:xz-$1:xz) < 1e-7"
point 0.13 0.27 0.31 field "abs($2:yy-$1:yy) < 1e-7"
point 0.13 0.27 0.31 field "abs($2:yz-$1:yz) < 1e-7"
point 0.13 0.27 0.31 field "abs($2:zz-$1:zz) < 1e-7"

# wien2k
crystal ../zz_source/wien14.2/zno/zno.struct
load ../zz_source/wien14.2/zno/zno.clmsum ../zz_source/wien14.2/zno/zno.struct analytical notestmt
load ../zz_source/wien14.2/zno/zno.clmsum ../zz_source/wien14.2/zno/zno.struct numerical notestmt
point 0.1 0.2 0.3 field "abs($2:x-$1:x) < 1e-10"
point 0.1 0.2 0.3 field "abs($2:y-$1:y) < 1e-10"
point 0.1 0.2 0.3 field "abs($2:z-$1:z) < 1e-10"
point 0.1 0.2 0.3 field "abs($2:xx-$1:xx) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:xy-$1:xy) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:xz-$1:xz) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:yy-$1:yy) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:yz-$1:yz) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:zz-$1:zz) < 1e-7"

# elk
crystal ../zz_source/elk-6.3.02/sbpo4/GEOMETRY.OUT
load ../zz_source/elk-6.3.02/sbpo4/STATE.OUT ../zz_source/elk-6.3.02/sbpo4/GEOMETRY.OUT analytical notestmt
load ../zz_source/elk-6.3.02/sbpo4/STATE.OUT ../zz_source/elk-6.3.02/sbpo4/GEOMETRY.OUT numerical notestmt
point 0.1 0.2 0.3 field "abs($2:x-$1:x) < 2e-3"
point 0.1 0.2 0.3 field "abs($2:y-$1:y) < 2e-3"
point 0.1 0.2 0.3 field "abs($2:z-$1:z) < 2e-3"
point 0.1 0.2 0.3 field "abs($2:xx-$1:xx) < 2e-1"
point 0.1 0.2 0.3 field "abs($2:xy-$1:xy) < 2e-1"
point 0.1 0.2 0.3 field "abs($2:xz-$1:xz) < 2e-1"
point 0.1 0.2 0.3 field "abs($2:yy-$1:yy) < 2e-1"
point 0.1 0.2 0.3 field "abs($2:yz-$1:yz) < 2e-1"
point 0.1 0.2 0.3 field "abs($2:zz-$1:zz) < 2e-1"

# pi
crystal
  cell 7.25655 7.25655 7.25655 90 90 90
  spg p m -3 m
  neq 0.50 0.50 0.50 Ca
  neq 0.00 0.00 0.00 Ti
  neq 0.50 0.00 0.00 O
endcrystal
load ../zz_source/pi7r16/catio3/ca.ion Ca \
     ../zz_source/pi7r16/catio3/ti.ion Ti \
     ../zz_source/pi7r16/catio3/o.ion O exact analytical
load ../zz_source/pi7r16/catio3/ca.ion Ca \
     ../zz_source/pi7r16/catio3/ti.ion Ti \
     ../zz_source/pi7r16/catio3/o.ion O exact numerical
point 0.1 0.2 0.3 field "abs($2:x-$1:x) < 1e-10"
point 0.1 0.2 0.3 field "abs($2:y-$1:y) < 1e-10"
point 0.1 0.2 0.3 field "abs($2:z-$1:z) < 1e-10"
point 0.1 0.2 0.3 field "abs($2:xx-$1:xx) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:xy-$1:xy) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:xz-$1:xz) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:yy-$1:yy) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:yz-$1:yz) < 1e-7"
point 0.1 0.2 0.3 field "abs($2:zz-$1:zz) < 1e-7"

# wfn
