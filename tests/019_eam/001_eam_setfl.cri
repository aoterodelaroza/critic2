## check: 001_eam_setfl.incritic -a1e-6
## delete: 001_eam_setfl.cro
## labels: regression quick nodata

# Three Cu atoms at general positions, relaxed with the potential the
# catalogue picks for copper (a setfl-format file). The arrangement has no
# symmetry, so the minimum it relaxes to depends on the tabulated F, rho and
# phi actually read from the file -- unlike a displaced high-symmetry cell,
# whose minimum is fixed by symmetry no matter what the potential says.
crystal
 cell 4.60 4.60 4.60 90 90 90 angstrom
 spg 1
 neq 0.2000 0.2000 0.2000 Cu
 neq 0.7000 0.7000 0.2500 Cu
 neq 0.2500 0.7000 0.7000 Cu
endcrystal
edit relax eam 1d-7
write 001_eam_setfl.incritic
