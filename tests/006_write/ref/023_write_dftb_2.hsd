Geometry = GenFormat {
10 C
 C H
1 1 0.599586000000       1.747721000000       0.000000000000       
2 1 0.599586000000       0.411296000000       0.000000000000       
3 1 -0.599586000000      -0.411296000000      0.000000000000       
4 1 -0.599586000000      -1.747721000000      0.000000000000       
5 2 1.519740000000       2.320752000000       0.000000000000       
6 2 -0.326860000000      2.314715000000       0.000000000000       
7 2 1.547612000000       -0.124729000000      0.000000000000       
8 2 -1.547612000000      0.124729000000       0.000000000000       
9 2 0.326860000000       -2.314715000000      0.000000000000       
10 2 -1.519740000000      -2.320752000000      0.000000000000       
}

Driver = ConjugateGradient {
       MovedAtoms = 1:-1
       MaxForceComponent = 1e-5
       MaxSteps = 3000
       LatticeOpt = Yes
       OutputPrefix = "geo_end"
}

Hamiltonian = DFTB{
  ThirdOrderFull = Yes
  SCC = Yes
  SCCTolerance = 1e-7
  MaxSCCIterations = 125
  MaxAngularMomentum = {
    C = p
    H = s
  }
  SlaterKosterFiles = Type2FileNames {
    Prefix = "xxx"
    Separator = "-"
    Suffix = ".skf"
    LowerCaseTypeName = No
  }
  DampXH = Yes
  DampXHExponent = 4.2
  HubbardDerivs {
    C = -0.1492
    H = -0.1857
  }
}

Options {
  WriteDetailedXML = Yes
}

ParserOptions {
  ParserVersion = 4
}

